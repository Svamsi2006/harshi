# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Your deployed production URL (e.g. https://harshi-virid.vercel.app) for SEO sitemap & robots.txt
APP_URL="https://your-domain.vercel.app"

# Supabase Configuration (keep SUPABASE_SECRET_KEY strictly server-side; SUPABASE_ANON_KEY enables Google Sign-In)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
DATABASE_URL="postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres"

# Admin Portal Access & PIN Security (strictly server-side; never prefix with VITE_)
ADMIN_EMAILS="seelamvamsisivaganesh@gmail.com,seelamharshi27@gmail.com"
ADMIN_PORTAL_PIN=""
ADMIN_RECOVERY_PET_NAME=""

# Razorpay Live Payment Gateway (keep RAZORPAY_KEY_SECRET strictly server-side)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_live_secret"

# SEO & Google Analytics 4
GA_MEASUREMENT_ID="G-XXXXXXXXXX"
GOOGLE_SITE_VERIFICATION="your-google-search-console-verification-token"

# Optional: enables the studio AI chatbot.
OPENROUTER_API_KEY="your-openrouter-api-key"
